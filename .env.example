APP_NAME=report-service
PORT=8082
HOST_NAME=localhost
IP_ADDR=127.0.0.1

EUREKA_URL=http://localhost:8761/eureka/

# PostgreSQL (base propia del servicio; se crea sola si no existe)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reports_db
DB_USER=postgres
DB_PASSWORD=

# Fotos
UPLOAD_DIR=uploads
MAX_PHOTOS=5
MAX_PHOTO_MB=5

# Expiración (HU-16) y recordatorio (HU-25)
EXPIRATION_DAYS=30
REMINDER_DAYS=3
EXPIRATION_CRON=0 2 * * *
